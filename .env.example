# Copy this file to .env and fill it in. Leave the Supabase values blank to
# run the app on built-in demo data.

# Supabase → Project Settings → API (or "Connect")
SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy "anon" key also works.
SUPABASE_PUBLISHABLE_KEY=

# Google Cloud → APIs & Services → Credentials → OAuth client of type
# "Web application" (the same Client ID you entered in Supabase → Auth → Google)
GOOGLE_WEB_CLIENT_ID=

# Optional: live traffic for the collector Route Guide. Free key (2,500
# routes/day) at https://developer.tomtom.com. Leave blank to use free
# OpenStreetMap roads with estimated rush-hour traffic.
TOMTOM_API_KEY=
